	keywords = {Actuators, Closed loop systems, Feedback control, Lyapunov methods, Observers, Wireless communication},
	file = {Full Text PDF:/home/eswarm/Zotero/storage/WCY7AHIV/Heemels et al. - 2012 - An introduction to event-triggered and self-triggered control.pdf:application/pdf;IEEE Xplore Abstract Record:/home/eswarm/Zotero/storage/S7ZS3UF4/6425820.html:text/html},

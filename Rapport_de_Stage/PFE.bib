	note = {{ISSN}: 1948-9447},
	keywords = {Rotors, Attitude control, Mathematical model, Aerospace electronics, Aircraft, Atmospheric modeling, backstepping, hardware redundancy, multi-rotor aircraft, trajectory tracking},
	file = {Full Text PDF:/home/eswarm/Zotero/storage/ECU4RC9T/Pan et al. - 2016 - A trajectory tracking control strategy for a novel multi-rotor aircraft.pdf:application/pdf;IEEE Xplore Abstract Record:/home/eswarm/Zotero/storage/RWYKM7VU/7531536.html:text/html},

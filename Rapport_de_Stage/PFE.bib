	keywords = {Robot kinematics, Mobile robots, Trajectory, Wheels, Nose, Transportation},
	file = {Full Text PDF:/home/eswarm/Zotero/storage/3IJGHLQP/Inglett et Rodríguez-Seda - 2017 - Object transportation by cooperative robots.pdf:application/pdf},
}

